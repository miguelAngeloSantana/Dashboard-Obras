generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Obra {
  id             String       @id @default(uuid())
  nome           String
  endereco       String
  cep            String?
  clienteNome    String
  clientTel      String?
  dataInicio     DateTime
  dataFim        DateTime?
  status         String       @default("Planejando")
  progresso_pct  Int
  orcamentoTotal Decimal?     @db.Decimal(12, 2)
  etapa          Etapa[]
  lancamentos    Lancamento[]
  pedidos        Pedido[]
  material       Material[]

  @@index([status])
  @@index([dataFim])
}

model Material {
  id           String   @id @default(uuid())
  nomeMaterial String
  qdtPlanejada Int?
  qtdAtual     Int
  obraNome     String[]
  qtdMinima    Int
  unidade      String
  valor        Decimal  @default(0) @db.Decimal(12, 2)

  estoque   Estoque?
  obra      Obra[]
  lacamento Lancamento[]
}

model Estoque {
  id            String         @id @default(uuid())
  qtdPlanejada  Int?
  qtdDisponivel Int
  qtdMinima     Int
  materialId    String         @unique
  material      Material       @relation(fields: [materialId], references: [id])
  movimentacao  Movimentacao[]

  @@index([qtdDisponivel])
}

model Etapa {
  id             String        @id @default(uuid())
  nome           String
  ordem          Int
  dataInicio     DateTime?
  dataFimPrev    DateTime?
  dataFim        DateTime?
  progressoPct   Int           @default(0)
  status         String        @default("Pendente")
  custoOrcamento Decimal       @db.Decimal(12, 2)
  pesoFixo       Int
  pesoFixoPadrao Decimal       @db.Decimal(5, 4)
  pesoOrcamento  Decimal?      @db.Decimal(5, 4)
  custoEtapa     Int?          @default(0)
  obraId         String
  obra           Obra          @relation(fields: [obraId], references: [id])
  subEtapa       SubEtapasDB[]

  @@index([obraId])
}

model Movimentacao {
  id         String   @id @default(uuid())
  estoqueId  String
  pedidoId   String?
  tipo       String
  quantidade Decimal  @db.Decimal(10, 3)
  dataHora   DateTime
  origem     String
  qtdAntes   Decimal  @db.Decimal(10, 3)
  atdDepois  Decimal  @db.Decimal(10, 3)
  observacao String?
  estoque    Estoque  @relation(fields: [estoqueId], references: [id])
  pedido     Pedido?  @relation(fields: [pedidoId], references: [id])

  @@index([estoqueId])
  @@index([pedidoId])
}

model Lancamento {
  id          String         @id @default(uuid())
  obraId      String
  materialId  String?
  etapaId     String?
  valor       Decimal        @db.Decimal(12, 2)
  data        DateTime
  descricao   String?
  notaFiscal  String?
  comprovante String?
  tipo        TipoLancamento
  obra        Obra           @relation(fields: [obraId], references: [id], onDelete: Cascade)
  material    Material?      @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([obraId, data])
  @@index([obraId, tipo])
}

model Pedido {
  id              String         @id @default(uuid())
  obraId          String
  fornecedorId    String
  dataPedido      DateTime       @default(now())
  dataPrevEntrega DateTime?
  status          String         @default("Avaliando")
  valorTotal      Decimal?       @db.Decimal(12, 2)
  itens           ItemPedido[]
  movimentacao    Movimentacao[]
  fornecedor      Fornecedor     @relation(fields: [fornecedorId], references: [id])
  obra            Obra           @relation(fields: [obraId], references: [id])

  @@index([obraId, status])
  @@index([fornecedorId])
  @@index([dataPrevEntrega])
}

model ItemPedido {
  id         String   @id @default(uuid())
  pedidoId   String
  quantidade Decimal  @db.Decimal(10, 3)
  precoUnit  Decimal? @db.Decimal(10, 2)
  materialId String
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])

  @@unique([pedidoId, materialId])
}

model Fornecedor {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String?  @unique
  telefone  String
  email     String
  endereco  String
  categoria String
  ativo     Boolean  @default(true)
  pedidos   Pedido[]

  @@index([ativo])
}

model SubEtapasDB {
  id           String @id @default(uuid())
  etapaId      String
  nome         String
  ordem        Int
  progressoPct Int    @default(0)
  pesoManual   Int?   @default(0)
  etapa        Etapa  @relation(fields: [etapaId], references: [id], onDelete: Cascade)
}

enum TipoLancamento {
  MATERIAL
  MAO_DE_OBRA
  EQUIPAMENTO
  SERVICO
  OUTRO
}
